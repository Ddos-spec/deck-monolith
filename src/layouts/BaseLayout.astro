---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DECK.MONOLITH — Brutalist Presentation Archive & AI Slide System",
  description = "Curated collection of 1,058 multi-layered PowerPoint presentations across 29 industries and 16 avant-garde design movements. Live stage preview and AI blueprints.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      try {
        if (localStorage.getItem("deck-vault-theme") === "obsidian") {
          document.documentElement.classList.add("theme-obsidian");
        }
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased selection:bg-[#C22F10] selection:text-white">
    <slot />

    <!-- Desktop Precision Architectural Reticle -->
    <div
      id="awwwards-cursor"
      aria-hidden="true"
      class="pointer-events-none fixed left-0 top-0 z-[95] hidden lg:flex h-6 w-6 -translate-x-1/2 -translate-y-1/2 items-center justify-center border border-[#C22F10] opacity-0 transition-opacity duration-200 mix-blend-difference"
    >
      <span class="h-1 w-1 bg-white"></span>
    </div>

    <!-- Global Copy / Save Toast -->
    <div
      id="vault-toast"
      role="status"
      aria-live="polite"
      class="pointer-events-none fixed bottom-5 right-5 z-[100] flex items-center gap-2.5 border-2 border-[#111111] bg-[#111111] px-4 py-2.5 font-mono text-xs font-semibold text-[#F2EFE9] shadow-[4px_4px_0px_#C22F10] opacity-0 translate-y-2 transition-all duration-200"
    >
      <span class="h-2 w-2 bg-[#2DD4BF]"></span>
      <span id="vault-toast-text">Copied</span>
    </div>
  </body>
</html>
