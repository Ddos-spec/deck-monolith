---
import { DECK_CATEGORIES, DECK_INDUSTRIES } from "../lib/deckCatalog";

interface Props {
  categoryCounts: Record<string, number>;
  industryCounts: Record<string, number>;
}

const { categoryCounts, industryCounts } = Astro.props;
---

<div
  id="filter-modal-backdrop"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="filter-modal-title"
>
  <div
    id="filter-modal-panel"
    data-open="false"
    class="vault-modal flex h-[min(620px,85vh)] w-full max-w-2xl flex-col overflow-hidden rounded-2xl border border-[#27272A] bg-[#18181B] shadow-2xl"
  >
    <!-- Top Search Bar inside Modal -->
    <div class="flex items-center gap-3 border-b border-[#27272A] px-4 py-3.5">
      <svg class="h-4 w-4 shrink-0 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="filter-modal-search"
        type="text"
        placeholder="Search categories or industries..."
        aria-label="Search filter options"
        class="w-full bg-transparent text-sm text-white placeholder:text-zinc-500 focus:outline-none"
      />
      <span id="filter-modal-title" class="sr-only">Filter Decks by Category and Industry</span>
      <button
        id="close-filter-modal-x"
        type="button"
        aria-label="Close filter modal"
        class="rounded-full p-1.5 text-zinc-400 transition-colors hover:bg-[#27272A] hover:text-white cursor-pointer"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <!-- Two-Pane Body: Left Sidebar (Category | Industry) + Right Live List -->
    <div class="flex min-h-0 flex-1 flex-col sm:flex-row">
      <!-- Left Sidebar -->
      <aside class="flex shrink-0 flex-row gap-1 border-b border-[#27272A] bg-[#141417] p-3 sm:w-48 sm:flex-col sm:border-b-0 sm:border-r">
        <button
          type="button"
          data-filter-pane-tab="category"
          class="filter-pane-tab flex flex-1 sm:flex-none items-center justify-between rounded-xl px-3 py-2.5 text-left text-xs font-medium transition-colors bg-[#27272A] text-white cursor-pointer"
        >
          <span>Category</span>
          <span id="pane-category-selected-count" class="rounded-full bg-white/10 px-2 py-0.5 font-mono text-[10px] text-zinc-300">
            {DECK_CATEGORIES.length}
          </span>
        </button>

        <button
          type="button"
          data-filter-pane-tab="industry"
          class="filter-pane-tab flex flex-1 sm:flex-none items-center justify-between rounded-xl px-3 py-2.5 text-left text-xs font-medium text-zinc-400 transition-colors hover:bg-[#202024] hover:text-zinc-200 cursor-pointer"
        >
          <span>Industry</span>
          <span id="pane-industry-selected-count" class="rounded-full bg-white/5 px-2 py-0.5 font-mono text-[10px] text-zinc-400">
            {DECK_INDUSTRIES.length}
          </span>
        </button>

        <div class="mt-auto hidden rounded-xl border border-[#27272A] bg-[#0D0D0F] p-3 sm:block">
          <p class="text-[11px] leading-relaxed text-zinc-400">
            Multi-select across <span class="text-zinc-200">10 categories</span> and <span class="text-zinc-200">29 verticals</span>. Counts update from active catalog.
          </p>
        </div>
      </aside>

      <!-- Right List -->
      <div class="min-h-0 flex-1 overflow-y-auto p-3 sm:p-4">
        <!-- Category Options -->
        <div id="filter-pane-category" class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
          {DECK_CATEGORIES.map((category) => (
            <button
              type="button"
              data-filter-kind="category"
              data-filter-value={category}
              class="filter-option-btn group flex items-center justify-between rounded-xl border border-[#27272A] bg-[#0D0D0F]/70 px-3.5 py-2.5 text-left transition-all hover:border-zinc-500 hover:bg-[#202024] cursor-pointer"
            >
              <div class="flex items-center gap-2.5">
                <span class="filter-check-box flex h-4 w-4 items-center justify-center rounded border border-[#3F3F46] bg-[#18181B] text-[10px] text-[#0D0D0F] transition-colors">
                  ✓
                </span>
                <span class="text-xs font-medium text-zinc-200 group-hover:text-white">{category}</span>
              </div>
              <span class="font-mono text-[11px] text-zinc-500 group-hover:text-zinc-300">
                {categoryCounts[category] ?? 0}
              </span>
            </button>
          ))}
        </div>

        <!-- Industry Options -->
        <div id="filter-pane-industry" class="hidden grid-cols-1 gap-1.5 sm:grid-cols-2">
          {DECK_INDUSTRIES.map((industry) => (
            <button
              type="button"
              data-filter-kind="industry"
              data-filter-value={industry}
              class="filter-option-btn group flex items-center justify-between rounded-xl border border-[#27272A] bg-[#0D0D0F]/70 px-3.5 py-2.5 text-left transition-all hover:border-zinc-500 hover:bg-[#202024] cursor-pointer"
            >
              <div class="flex items-center gap-2.5">
                <span class="filter-check-box flex h-4 w-4 items-center justify-center rounded border border-[#3F3F46] bg-[#18181B] text-[10px] text-[#0D0D0F] transition-colors">
                  ✓
                </span>
                <span class="text-xs font-medium text-zinc-200 group-hover:text-white">{industry}</span>
              </div>
              <span class="font-mono text-[11px] text-zinc-500 group-hover:text-zinc-300">
                {industryCounts[industry] ?? 0}
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer with Clear & Done Button -->
    <div class="flex items-center justify-between border-t border-[#27272A] bg-[#141417] px-4 py-3">
      <button
        id="filter-modal-clear-btn"
        type="button"
        class="rounded-full px-3.5 py-1.5 text-xs font-medium text-zinc-400 transition-colors hover:bg-[#27272A] hover:text-white cursor-pointer"
      >
        Reset all filters
      </button>
      <div class="flex items-center gap-3">
        <span id="filter-modal-match-label" class="font-mono text-xs text-zinc-400"></span>
        <button
          id="filter-modal-done-btn"
          type="button"
          class="rounded-full bg-white px-5 py-2 text-xs font-semibold text-[#0D0D0F] transition-transform hover:bg-zinc-200 active:scale-[0.98] cursor-pointer"
        >
          Done
        </button>
      </div>
    </div>
  </div>
</div>
